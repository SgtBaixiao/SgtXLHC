{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人网站：Agent 工作状态实时图 + 开发进度图 + Notion 随笔归档。Astro 静态输出，GitHub Pages 免费部署。",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "progress": "node scripts/generate-progress.mjs",
    "sync:status": "node scripts/sync-status.mjs",
    "notion:list": "node scripts/notion-publish.mjs --list",
    "notion:publish": "node scripts/notion-publish.mjs",
    "bridge": "node scripts/publish-bridge.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.4.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@notionhq/client": "^2.2.15",
    "@types/node": "^22.10.0",
    "notion-to-md": "^3.1.9",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
