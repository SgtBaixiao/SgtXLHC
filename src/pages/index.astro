---
import Base from '../layouts/Base.astro';
import { SITE, base } from '../lib/site';
import { entrySlug } from '../lib/essays';
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  ;
const recent = essays.length ? essays[0] : null;

---

<Base title={SITE.title} description={SITE.description} active="/">
  <section class="hero container">
    <p class="mono hero__kicker" data-reveal>WORKSPACE — DEV LOG</p>
    <h1 class="hero__title" data-reveal>
      Agent <em>Workspace</em>
    </h1>
    <p class="hero__sub" data-reveal>{SITE.tagline}</p>
    <p class="hero__lede" data-reveal>
      首页展示 agent 实时工作状态；进度页展示 wayfinder 决策图谱；
      随笔页归档 Notion 文章。状态由各 agent 在会话结束/停止时上报，
      通过页面轮询读取最新公开状态。
    </p>
    <div class="hero__cta" data-reveal>
      <a class="btn" href={`${base}progress/`}>查看进度 <span aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href={`${base}essays/`}>阅读随笔</a>
    </div>
  </section>

  <section class="container section">
    <div class="section__head">
      <p class="mono" data-reveal>01 / LIVE</p>
      <h2 data-reveal>Agent 状态</h2>
    </div>

    <div class="stage drawer-shell" data-graph-shell>
      <div class="drawer-shell__main">
        <canvas class="stage__canvas" data-agent-graph aria-label="Agent 工作状态图"></canvas>
        <div class="stage__empty" data-graph-empty hidden>
          <p class="mono">NO AGENTS YET</p>
          <p class="mono stage__empty-sub">等待第一个 agent 上报状态…</p>
        </div>
      </div>
      <aside class="drawer" data-graph-drawer aria-label="节点详情" role="complementary">
        <button class="drawer__close mono" data-drawer-close type="button" aria-label="关闭详情">✕</button>
        <div class="drawer__body"></div>
      </aside>
    </div>

    <div class="stage__legend mono">
      <span class="chip"><i style="background:var(--st-idle)"></i>待命</span>
      <span class="chip"><i style="background:var(--st-working)"></i>工作</span>
      <span class="chip"><i style="background:var(--st-blocked)"></i>阻塞</span>
      <span class="chip"><i style="background:var(--st-error)"></i>错误</span>
    </div>
    <p class="mono stage__hint" data-status-meta>加载中…</p>
    <p class="mono stage__hint">拖拽平移 · 滚轮缩放 · 点击节点查看详情 · 约 90s 自动刷新</p>
  </section>

  <section class="container section">
    <div class="section__head">
      <p class="mono" data-reveal>02 / RECENT</p>
      <h2 data-reveal>最新随笔</h2>
    </div>
    <div class="cards">
      {recent ? (
        <a class="card card--feature" href={`${base}essays/${entrySlug(recent)}/`}>
          <p class="mono card__date">{recent.data.date.toISOString().slice(0, 10)}</p>
          <h3>{recent.data.title}</h3>
          <p class="card__excerpt">{recent.data.excerpt}</p>
          <div class="card__tags">
            {(recent.data.tags || []).map((t) => <span class="tag mono">{t}</span>)}
          </div>
          <span class="mono card__more">READ →</span>
        </a>
      ) : (
        <p class="muted">尚无随笔。随笔通过 Notion 管道发布后自动归档于此。</p>
      )}
      {essays.slice(1, 5).map((e) => (
        <a class="card" href={`${base}essays/${entrySlug(e)}/`}>
          <p class="mono card__date">{e.data.date.toISOString().slice(0, 10)}</p>
          <h3>{e.data.title}</h3>
          <span class="mono card__more">READ →</span>
        </a>
      ))}
    </div>
    {essays.length > 5 && (
      <a class="mono section__more" href={`${base}essays/`}>全部随笔 {essays.length} →</a>
    )}
  </section>
</Base>

<style>
  .hero__kicker { color: var(--ink-faint); margin: 0 0 1rem; letter-spacing: var(--track-meta); }
  .hero__title { font-size: clamp(2.6rem, 7vw, 4.6rem); line-height: 1.02; margin: 0 0 1rem; letter-spacing: var(--track-display); }
  .hero__title em { font-style: normal; color: var(--ink-faint); }
  .hero__sub { font-family: var(--font-mono); font-size: var(--step-1); color: var(--ink-soft); margin: 0 0 1.4rem; letter-spacing: var(--track-meta); text-transform: uppercase; }
  .hero__lede { max-width: 34rem; color: var(--ink-soft); }
  .hero__cta { display: flex; gap: 1rem; margin-top: 2.2rem; flex-wrap: wrap; }

  .section__head { margin-bottom: 2.4rem; display: grid; gap: .35rem; }
  .section__head .mono { color: var(--ink-faint); letter-spacing: var(--track-meta); margin: 0; }
  .section__head h2 { margin: 0; }
  .section__more { display: inline-block; margin-top: 1.8rem; color: var(--ink-faint); text-decoration: none; letter-spacing: var(--track-meta); }
  .section__more:hover { color: var(--ink); }

  .stage { margin-bottom: 1rem; }
  .stage__empty-sub { margin: .4rem 0 0; color: var(--ink-ghost); font-size: var(--step--1); text-transform: none; }
  .stage__legend { display: flex; flex-wrap: wrap; gap: .4rem 1.6rem; margin-bottom: .6rem; color: var(--ink-faint); }
  .stage__hint { color: var(--ink-faint); font-size: var(--step--1); margin: 0 0 .25rem; letter-spacing: var(--track-meta); }

  .card--feature { display: flex; flex-direction: column; gap: .6rem; grid-row: span 1; }
  .card__more { margin-top: auto; padding-top: 1.2rem; color: var(--ink-faint); letter-spacing: var(--track-meta); transition: color var(--dur-fast) var(--ease-out); }
  .card:hover .card__more { color: var(--ink); }
  .muted { color: var(--ink-faint); }
</style>

<script>
  import { initAgentGraph } from '../components/AgentGraph.js';
  initAgentGraph();
  window.addEventListener('pageshow', (event) => { if (event.persisted) initAgentGraph(); });
</script>
